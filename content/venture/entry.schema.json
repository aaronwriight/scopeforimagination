{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aaronwriight.vercel.app/schemas/venture-entry.json",
  "title": "Venture Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "title",
    "subtitle",
    "excerpt",
    "entry",
    "slug",
    "date",
    "time",
    "trip",
    "thread",
    "location",
    "latitude",
    "longitude",
    "tags",
    "blog",
    "collections",
    "status",
    "bodyHtml"
  ],
  "properties": {
    "$schema": { "const": "../entry.schema.json" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string", "minLength": 1 },
    "excerpt": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "pattern": "^[0-9]{4}$" },
    "slug": {
      "type": "string",
      "pattern": "^[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{8}$"
    },
    "date": { "type": "string", "format": "date" },
    "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "trip": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "thread": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        { "type": "null" }
      ]
    },
    "location": { "type": "string", "minLength": 1 },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "music": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "artist"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "album": { "type": "string", "minLength": 1 },
            "artist": { "type": "string", "minLength": 1 },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://"
            }
          }
        }
      ]
    },
    "blog": { "const": "venture" },
    "tags": {
      "type": "array",
      "contains": { "const": "venture" },
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "status": { "const": "published" },
    "bodyHtml": { "type": "string", "minLength": 1 }
  }
}
