{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aaronwriight.vercel.app/schemas/venture-travels.json",
  "title": "Venture International Travels Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["destinations"],
  "properties": {
    "$schema": { "type": "string" },
    "destinations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/destination" }
    }
  },
  "$defs": {
    "visit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "date", "trip"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "date": { "type": ["string", "null"], "format": "date" },
        "trip": { "type": ["string", "null"], "minLength": 1 },
        "entrySlug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "region", "latitude", "longitude", "visits"],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "visits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/visit" }
        }
      }
    }
  }
}
